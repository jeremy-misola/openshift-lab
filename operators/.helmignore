# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# These subdirectories are independent Helm charts, each deployed as its
# own Argo CD Application by the ApplicationSet this chart renders
# (see templates/application-set.yaml and values/hub.yaml). They are not
# subcharts of hub-operators: ignore them so `helm template` on this chart
# only renders the AppProject + ApplicationSet, instead of Helm's default
# behavior of auto-loading every directory under charts/ as a subchart.
charts/
